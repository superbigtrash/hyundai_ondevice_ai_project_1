        <mxCell id="delay" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;verticalAlign=middle;" value="해당 통과 신호 확인 후&#10;설정 시간 대기" vertex="1">
          <mxGeometry height="65" width="310" x="890" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="clear" parent="1" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;verticalAlign=middle;" value="모형의 닫힘 조건 충족?&#10;장애물 확인 방법은 미정" vertex="1">
          <mxGeometry height="110" width="290" x="900" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="hold" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;verticalAlign=middle;" value="모형 문 닫힘 보류·원인 표시&#10;재확인 또는 관리자 조작" vertex="1">
