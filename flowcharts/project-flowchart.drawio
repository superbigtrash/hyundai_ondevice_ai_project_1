        </mxCell>
        <mxCell id="timeout" parent="1" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;verticalAlign=middle;" value="미통과 대기 한도 초과?&#10;아니요: ②에서 계속 확인" vertex="1">
