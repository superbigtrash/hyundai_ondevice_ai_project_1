        </mxCell>
        <mxCell id="manual" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;verticalAlign=middle;" value="미통과 처리 정책 적용 [미정]&#10;재확인 / 관리자 조작 등 결정&#10;재개 시 ②로 복귀" vertex="1">
          <mxGeometry height="100" width="330" x="420" y="1400" as="geometry" />
